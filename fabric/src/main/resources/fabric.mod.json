{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "contact": {
        "issues": "${mod_issues}",
        "sources": "${mod_source}"
    },
    "authors": [
        "${mod_author}"
    ],
    "contributors": [
        "${mod_credits}"
    ],
    "license": "${mod_license}",
    "icon": "assets/${mod_id}/logo.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "${mod_group}.${mod_id}.ModFabric"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "java": ">=${java_version}",
        "minecraft": "${minecraft_version}",
        "fabric": ">=${fabric_version}",
        "fabricloader": ">=${fabric_loader_version}",
        "balm": ">=${balm_version}"
    }
}
